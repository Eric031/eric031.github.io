---
/**
 * The "attachment" on each ticket: a small drawn preview of the work. No screenshots and no
 * brand marks, only shapes in the lane colour (--c). Decorative: every fact in it is also in
 * the ticket text. Entrances play when the ticket scrolls in; loops run only on hover or focus.
 */
import { langOf, type ProjectKey } from '../copy';
import { getData } from '../data';

interface Props {
  k: ProjectKey;
}
const { k } = Astro.props;
const v = getData(langOf(Astro.url)).t.vis;

const WAVE = [14, 26, 40, 22, 52, 34, 60, 30, 44, 18, 50, 28, 38, 56, 24, 42, 20, 32];
const CALLS: [number, 'on' | 'next' | 'free'][] = [
  [70, 'on'],
  [58, 'next'],
  [76, 'free'],
  [64, 'on'],
  [52, 'free'],
  [72, 'next'],
  [60, 'on'],
];
const DOMS = [96, 74, 108, 86, 64, 92];
const BADGES: [string, number, number][] = [
  ['CSP', 34, 58],
  ['HSTS', 100, 62],
  ['DNSSEC', 170, 76],
];
---

<svg class="vis" viewBox="0 0 280 150" width="280" height="150" focusable="false" aria-hidden="true">
  {
    k === 'shop' && (
      <g>
        <rect x="16" y="44" width="84" height="54" rx="8" class="v-card" />
        <rect x="27" y="56" width="16" height="12" rx="3" class="v-chip" />
        <text x="27" y="88" class="v-t">•••• 4242</text>
        <path d="M106 71 H124" class="v-flow" />
        <path d="M140 47 l18 7 v13 c0 11 -8 18 -18 23 c-10 -5 -18 -12 -18 -23 v-13 z" class="v-shield" />
        <path d="M132.5 69 l5 5 l9.5 -10" class="v-tick v-pop" style="--i:1" />
        <text x="140" y="114" text-anchor="middle" class="v-t">3-D Secure</text>
        <path d="M162 71 H180" class="v-flow" />
        <g class="v-pop" style="--i:4">
          <rect x="184" y="57" width="82" height="28" rx="14" class="v-okbg" />
          <text x="225" y="75" text-anchor="middle" class="v-okt">{v.approved}</text>
        </g>
      </g>
    )
  }
  {
    k === 'relaunch' && (
      <g>
        <rect x="18" y="14" width="244" height="122" rx="10" class="v-frame" />
        <path d="M18 36 H262" class="v-line" />
        <circle cx="31" cy="25" r="3" class="v-dim2" />
        <circle cx="41" cy="25" r="3" class="v-dim2" />
        <circle cx="51" cy="25" r="3" class="v-dim2" />
        <rect x="66" y="19" width="160" height="12" rx="6" class="v-dim" />
        <rect x="74" y="23.5" width="6" height="4.5" rx="1" class="v-c" />
        <path d="M75.2 23.5 v-1.4 a1.8 1.8 0 0 1 3.6 0 v1.4" class="v-cs v-thin" />
        <rect x="86" y="23.5" width="70" height="4" rx="2" class="v-dim" />
        {BADGES.map(([b, x, w], i) => (
          <g class="v-pop" style={`--i:${i}`}>
            <rect x={x} y="50" width={w} height="24" rx="12" class="v-pill" />
            <circle cx={x + 13} cy="62" r="4" class="v-ok" />
            <text x={x + 23} y="66" class="v-T">{b}</text>
          </g>
        ))}
        <text x="34" y="98" class="v-t">sitemap.xml</text>
        <text x="246" y="98" text-anchor="end" class="v-T">20/20</text>
        <rect x="34" y="106" width="212" height="8" rx="4" class="v-dim" />
        <rect x="34" y="106" width="212" height="8" rx="4" class="v-c v-grow" />
      </g>
    )
  }
  {
    k === 'incident' && (
      <g>
        <text x="20" y="30" class="v-t">{v.detections}</text>
        {Array.from({ length: 9 }, (_, i) => (
          <g>
            <circle cx={34 + i * 26} cy="64" r="10" class="v-dot v-turn" style={`--i:${i}`} />
            <path d={`M${29 + i * 26} 64 l3.5 3.5 l6.5 -7`} class="v-tick-dark v-pop" style={`--i:${i + 2}`} />
          </g>
        ))}
        <text x="20" y="120" class="v-big">9</text>
        <text x="46" y="106" class="v-T">{v.vendors}</text>
        <text x="46" y="120" class="v-t">{v.days}</text>
      </g>
    )
  }
  {
    k === 'portal' && (
      <g>
        <rect x="16" y="14" width="96" height="122" rx="10" class="v-frame" />
        <circle cx="64" cy="38" r="9" class="v-c" />
        <rect x="30" y="58" width="68" height="10" rx="5" class="v-dim" />
        <rect x="30" y="74" width="68" height="10" rx="5" class="v-dim" />
        <rect x="30" y="94" width="68" height="14" rx="7" class="v-c" />
        <rect x="44" y="116" width="40" height="4" rx="2" class="v-dim" />
        <rect x="122" y="14" width="142" height="122" rx="10" class="v-frame" />
        <path d="M152 14 V136" class="v-line" />
        <rect x="130" y="26" width="14" height="4" rx="2" class="v-c" />
        <rect x="130" y="38" width="14" height="4" rx="2" class="v-dim" />
        <rect x="130" y="48" width="14" height="4" rx="2" class="v-dim" />
        <rect x="130" y="58" width="14" height="4" rx="2" class="v-dim" />
        <rect x="162" y="26" width="44" height="28" rx="6" class="v-dim" />
        <rect x="212" y="26" width="44" height="28" rx="6" class="v-dim" />
        <rect x="168" y="44" width="22" height="4" rx="2" class="v-c v-grow" />
        <rect x="218" y="44" width="30" height="4" rx="2" class="v-c v-grow" style="--i:1" />
        <path d="M164 118 L182 104 L198 110 L216 90 L234 96 L254 72" class="v-cs v-draw" />
      </g>
    )
  }
  {
    k === 'move' && (
      <g>
        <rect x="20" y="40" width="98" height="66" rx="8" class="v-frame" />
        <path d="M22 43 L69 78 L116 43" class="v-cs v-thin" />
        <path d="M126 73 H146" class="v-flow" />
        {['SPF', 'DKIM', 'DMARC'].map((b, i) => (
          <g class="v-pop" style={`--i:${i}`}>
            <rect x="152" y={32 + i * 30} width="110" height="24" rx="12" class="v-pill" />
            <text x="166" y={48 + i * 30} class="v-T">{b}</text>
            <text x="238" y={48 + i * 30} text-anchor="end" class="v-okt">pass</text>
            <circle cx="249" cy={44 + i * 30} r="4" class="v-ok" />
          </g>
        ))}
        <text x="20" y="128" class="v-t">{v.templates}</text>
      </g>
    )
  }
  {
    k === 'transcripts' && (
      <g>
        {WAVE.map((h, i) => (
          <rect x={18 + i * 6} y={64 - h / 2} width="3.5" height={h} rx="1.75" class="v-c v-wave" style={`--i:${i}`} />
        ))}
        <path d="M132 64 H152" class="v-flow" />
        <path d="M164 16 h50 l18 18 v80 a4 4 0 0 1 -4 4 h-64 a4 4 0 0 1 -4 -4 v-94 a4 4 0 0 1 4 -4 z" class="v-frame" />
        <path d="M214 16 v18 h18" class="v-line" />
        <text x="172" y="38" class="v-T">PDF</text>
        <rect x="172" y="50" width="48" height="5" rx="2.5" class="v-c" />
        <rect x="172" y="62" width="44" height="4" rx="2" class="v-dim" />
        <rect x="172" y="72" width="50" height="4" rx="2" class="v-dim" />
        <rect x="172" y="82" width="36" height="4" rx="2" class="v-dim" />
        <rect x="172" y="92" width="46" height="4" rx="2" class="v-dim" />
        <text x="18" y="126" class="v-big">{v.count}</text>
        <text x="18" y="142" class="v-t">{v.pdfs}</text>
      </g>
    )
  }
  {
    k === 'recordings' && (
      <g>
        <text x="18" y="28" class="v-T">{v.files}</text>
        {[1, 1, 0.42].map((f, i) => (
          <g>
            <rect x="18" y={44 + i * 30} width="28" height="20" rx="4" class="v-frame" />
            <circle cx="38" cy={54 + i * 30} r="2.5" class={f === 1 ? 'v-ok' : 'v-c v-blink'} />
            <rect x="58" y={50 + i * 30} width="170" height="8" rx="4" class="v-dim" />
            <rect x="58" y={50 + i * 30} width={170 * f} height="8" rx="4" class={f === 1 ? 'v-ok v-grow' : 'v-c v-grow'} style={`--i:${i}`} />
            {f === 1 ? (
              <path d={`M240 ${54 + i * 30} l4 4 l8 -8`} class="v-tick v-pop" style={`--i:${i + 4}`} />
            ) : (
              <text x="240" y={58 + i * 30} class="v-t">…</text>
            )}
          </g>
        ))}
      </g>
    )
  }
  {
    k === 'callboard' && (
      <g>
        <rect x="34" y="12" width="212" height="112" rx="8" class="v-frame" />
        <path d="M140 124 v10 M118 136 h44" class="v-line" />
        {CALLS.map(([w, st], i) => (
          <g>
            <rect x="48" y={23 + i * 14} width={w} height="6" rx="3" class="v-dim" />
            <rect x="140" y={23 + i * 14} width="46" height="6" rx="3" class="v-dim" />
            <circle
              cx="226"
              cy={26 + i * 14}
              r="4"
              class={st === 'on' ? 'v-ok v-blink v-pop' : st === 'next' ? 'v-amber v-pop' : 'v-dim2 v-pop'}
              style={`--i:${i}`}
            />
          </g>
        ))}
      </g>
    )
  }
  {
    k === 'kyb' && (
      <g>
        <rect x="46" y="34" width="84" height="104" rx="6" class="v-frame v-o3" />
        <rect x="34" y="24" width="84" height="104" rx="6" class="v-frame v-o6" />
        <rect x="22" y="14" width="84" height="104" rx="6" class="v-frame v-solid" />
        <text x="32" y="34" class="v-T">KYB</text>
        <rect x="32" y="44" width="60" height="4" rx="2" class="v-c" />
        <rect x="32" y="56" width="52" height="4" rx="2" class="v-dim" />
        <rect x="32" y="66" width="62" height="4" rx="2" class="v-dim" />
        <rect x="32" y="76" width="44" height="4" rx="2" class="v-dim" />
        <rect x="32" y="86" width="56" height="4" rx="2" class="v-dim" />
        <text x="150" y="30" class="v-t">{v.profile}</text>
        {[78, 62, 86, 70].map((w, i) => (
          <g class="v-pop" style={`--i:${i}`}>
            <rect x="150" y={42 + i * 22} width="14" height="14" rx="4" class="v-okbg" />
            <path d={`M153.5 ${49 + i * 22} l3 3 l5.5 -6`} class="v-tick" />
            <rect x="172" y={46 + i * 22} width={w} height="6" rx="3" class="v-dim" />
          </g>
        ))}
      </g>
    )
  }
  {
    k === 'domains' && (
      <g>
        <text x="20" y="28" class="v-t">DNS</text>
        {['SPF', 'DKIM', 'DMARC'].map((h, i) => (
          <text x={176 + i * 34} y="28" text-anchor="middle" class="v-t">
            {h}
          </text>
        ))}
        <path d="M20 36 H260" class="v-line" />
        {DOMS.map((w, r) => (
          <g>
            <rect x="20" y={46 + r * 14} width={w} height="6" rx="3" class="v-dim" />
            {[0, 1, 2].map((c) => (
              <circle cx={176 + c * 34} cy={49 + r * 14} r="3.6" class="v-ok v-pop" style={`--i:${r + c}`} />
            ))}
          </g>
        ))}
        <text x="20" y="140" class="v-T">{v.domains}</text>
      </g>
    )
  }
  {
    k === 'booking' && (
      <g>
        <rect x="70" y="8" width="92" height="140" rx="16" class="v-frame v-solid" />
        <rect x="102" y="15" width="28" height="4" rx="2" class="v-dim" />
        <text x="82" y="38" class="v-t">NOV</text>
        {Array.from({ length: 20 }, (_, i) => (
          <rect
            x={82 + (i % 5) * 14}
            y={46 + Math.floor(i / 5) * 14}
            width="10"
            height="10"
            rx="3"
            class={i === 13 ? 'v-c' : i % 7 === 3 ? 'v-dim v-o3' : 'v-dim'}
          />
        ))}
        <g class="v-pop" style="--i:2">
          <rect x="82" y="108" width="68" height="22" rx="11" class="v-c" />
          <text x="116" y="123" text-anchor="middle" class="v-dark">{v.booked}</text>
        </g>
        <g class="v-push">
          <rect x="140" y="20" width="126" height="40" rx="10" class="v-bubble" />
          <circle cx="156" cy="40" r="7" class="v-c" />
          <text x="170" y="36" class="v-T">{v.reminder}</text>
          <text x="170" y="50" class="v-t">{v.reminderText}</text>
        </g>
      </g>
    )
  }
</svg>
