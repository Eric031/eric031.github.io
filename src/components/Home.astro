---
import Base from '../layouts/Base.astro';
import { content, email, github, name, repo, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'en' ? '/' : '/sr/';
const year = new Date().getFullYear();
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <a class="skip" href="#main">{t.skip}</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={home}>
        <span class="mark" aria-hidden="true">DE</span>
        <span class="brand-name">{name}</span>
      </a>
      <nav class="nav" aria-label={t.nav.label}>
        <a href="#work">{t.nav.work}</a>
        <a href="#skills">{t.nav.skills}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <a
        class="lang"
        href={t.langSwitch.href}
        hreflang={t.langSwitch.lang}
        lang={t.langSwitch.lang}
        aria-label={t.langSwitch.label}>{t.langSwitch.short}</a
      >
    </div>
  </header>

  <main id="main">
    <section class="hero wrap">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#work">{t.hero.primary}</a>
        <a class="btn btn-ghost" href={`mailto:${email}`}>{t.hero.secondary}</a>
      </div>
      <dl class="facts">
        {
          t.hero.facts.map((f) => (
            <div class="fact">
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <div class="section-head">
        <p class="kicker">01</p>
        <h2 id="work-title">{t.work.title}</h2>
        <p class="section-intro">{t.work.intro}</p>
      </div>
      <div class="work-grid">
        {
          t.work.items.map((item, i) => (
            <article class:list={['card', { featured: i === 0 }]}>
              <h3>{item.title}</h3>
              <p class="context">{item.context}</p>
              <ul class="points">
                {item.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <ul class="chips" aria-label={t.work.stackLabel}>
                {item.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills" class="section wrap" aria-labelledby="skills-title">
      <div class="section-head">
        <p class="kicker">02</p>
        <h2 id="skills-title">{t.skills.title}</h2>
      </div>
      <div class="skills-grid">
        {
          t.skills.groups.map((g) => (
            <div class="skill">
              <h3>{g.title}</h3>
              <ul>
                {g.items.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section wrap" aria-labelledby="approach-title">
      <div class="section-head">
        <p class="kicker">03</p>
        <h2 id="approach-title">{t.approach.title}</h2>
      </div>
      <div class="approach-grid">
        {
          t.approach.items.map((p, i) => (
            <div class="principle">
              <span class="num">{pad(i + 1)}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="experience" class="section wrap" aria-labelledby="experience-title">
      <div class="section-head">
        <p class="kicker">04</p>
        <h2 id="experience-title">{t.experience.title}</h2>
      </div>
      <ol class="timeline">
        {
          t.experience.items.map((r) => (
            <li class="role">
              <p class="period">{r.period}</p>
              <div>
                <h3>{r.role}</h3>
                <p class="org">{r.org}</p>
                <p class="desc">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="contact" class="section wrap" aria-labelledby="contact-title">
      <div class="contact-card">
        <p class="kicker">05</p>
        <h2 id="contact-title">{t.contact.title}</h2>
        <p>{t.contact.text}</p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${email}`}>{email}</a>
          <a class="btn btn-ghost" href={github} rel="me">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span>© {year} {name}</span>
      <span>{t.footer.builtWith} · <a href={repo}>{t.footer.source}</a></span>
    </div>
  </footer>
</Base>
